    "@types/chance": "1.1.8",
    "@types/dotenv-flow": "3.3.3",
    "@types/file-saver": "2.0.7",
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.7.2",
    "@types/node": "24.13.3",
    "@vite-pwa/sveltekit": "1.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "chance": "1.1.13",
