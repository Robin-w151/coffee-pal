{
  "name": "coffee-pal",
  "version": "0.34.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robin-w151/coffee-pal.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "generate:screenshots": "node scripts/generate-screenshots.js",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "TEST_LOCAL_PREVIEW=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "pnpm build && pnpm test:visual:run",
    "test:visual:run": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm build && pnpm test:visual:run --update-snapshots",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:strict": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "verify": "pnpm check:strict && pnpm lint && pnpm build && pnpm test:unit && pnpm test:e2e:local",
    "verify:strict": "pnpm verify && pnpm test:visual:run",
    "migration:status": "node scripts/migration-status.js",
    "visual:review": "pnpm test:visual; node scripts/visual-review.js && open test-results/visual-review.html",
    "visual:review:base": "node scripts/visual-review.js --base origin/main && open test-results/visual-review.html",
    "sme": "source-map-explorer .svelte-kit/output/client/**/*.js",
    "prepare": "husky && svelte-kit sync",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/git": "10.0.1",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/chance": "1.1.8",
    "@types/dotenv-flow": "3.3.3",
    "@types/file-saver": "2.0.7",
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@unplugin-pwa/core": "0.0.3",
    "@vite-pwa/sveltekit": "2.0.0",
    "@vite-pwa/workbox-swkit": "8.0.13",
    "@vitest/coverage-v8": "4.1.12",
    "chance": "1.1.13",
    "comlink": "4.4.2",
    "dexie": "4.4.7",
    "dotenv-flow": "4.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "kolorist": "1.8.0",
    "lint-staged": "16.4.0",
    "lodash-es": "4.18.1",
    "luxon": "3.7.2",
    "pinst": "3.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "runed": "0.38.0",
    "rxjs": "7.8.2",
    "scroll-into-view-if-needed": "3.1.0",
    "semantic-release": "25.0.9",
    "source-map-explorer": "2.5.3",
    "svelte": "5.57.3",
    "svelte-awesome": "3.3.5",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "uuid": "14.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "webdav": "5.11.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#lib/*": "./src/lib/*"
  }
}
