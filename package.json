    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "3.5.2",
    "rxjs": "7.8.2",
    "scroll-into-view-if-needed": "3.1.0",
    "semantic-release": "25.0.8",
    "source-map-explorer": "2.5.3",
