    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@playwright/test": "1.62.0",
    "@semantic-release/git": "10.0.1",
    "@skeletonlabs/skeleton": "5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.70.2",
