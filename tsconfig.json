{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "vite/client", "@unplugin-pwa/core/info"]
  },
  "include": [
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts",
    "./scripts/**/*.ts",
    "./src/**/*.js",
    "./src/**/*.ts",
    "./src/**/*.svelte",
    "./tests/**/*.js",
    "./tests/**/*.ts",
    "./tests/**/*.svelte",
    "./vite.config.ts"
  ],
  "exclude": [
    ".svelte-kit/[!ambient.d.ts]**",
    "./node_modules/**",
    "./src/service-worker.js",
    "./src/service-worker.ts",
    "./src/service-worker.d.ts"
  ]
}
